<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginScreen" extends="Group" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <interface>
        <field id="theme" type="assocarray" onChange="OnThemeChanged" />
        <field id="loginSuccess" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/api.brs" />
    <script type="text/brightscript" uri="pkg:/components/LoginScreen.brs" />

    <!--
      Layout is authored in 1920x1080. Roku scales this UI for 720p HD,
      1080p FHD, and 4K panels. Safe margin ~80px so text is not clipped
      on panels with overscan.
    -->
    <children>
        <Rectangle id="loginBg" width="1920" height="1080" color="0x0E1015FF" />

        <!-- Header -->
        <Label
            id="brandTitle"
            translation="[80, 48]"
            width="1760"
            text="StreamingTV"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF" />
        <Label
            id="brandSub"
            translation="[80, 110]"
            width="1760"
            text="Player Setup (Beta)"
            font="font:MediumSystemFont"
            color="0xAAAAAAFF" />

        <!-- ================= PLAYER SETUP (default) ================= -->
        <Group id="playerSetupPanel" translation="[80, 180]">
            <!-- QR -->
            <Poster
                id="setupQrPoster"
                translation="[40, 40]"
                width="360"
                height="360"
                loadDisplayMode="scaleToFit"
                uri="" />
            <Label
                id="setupQrFallback"
                translation="[40, 120]"
                width="360"
                horizAlign="center"
                text="QR code"
                font="font:MediumSystemFont"
                color="0x666666FF" />

            <!-- Right column: instructions + codes (wide labels, wrapped) -->
            <Label
                translation="[480, 20]"
                width="1200"
                text="1. Scan the QR code with your phone"
                font="font:LargeSystemFont"
                color="0xFFFFFFFF" />
            <Label
                translation="[480, 70]"
                width="1200"
                wrap="true"
                maxLines="2"
                text="Or open the website below on your phone or computer and type the code."
                font="font:MediumSystemFont"
                color="0xAAAAAAFF" />

            <Label
                id="setupUrlLabel"
                translation="[480, 150]"
                width="1200"
                text="streamingtvroku.pages.dev"
                font="font:LargeBoldSystemFont"
                color="0xFFA726FF" />

            <!-- MAC -->
            <Label
                translation="[480, 230]"
                width="400"
                text="DEVICE ID"
                font="font:SmallBoldSystemFont"
                color="0xAAAAAAFF" />
            <Rectangle translation="[480, 265]" width="700" height="80" color="0x1A1D24FF">
                <Label
                    id="setupMacLabel"
                    translation="[10, 12]"
                    width="680"
                    horizAlign="center"
                    vertAlign="center"
                    text="------"
                    font="font:LargeBoldSystemFont"
                    color="0xFFFFFFFF" />
            </Rectangle>

            <!-- PIN -->
            <Label
                translation="[480, 370]"
                width="400"
                text="PIN"
                font="font:SmallBoldSystemFont"
                color="0xAAAAAAFF" />
            <Rectangle translation="[480, 405]" width="700" height="100" color="0x1A1D24FF">
                <Label
                    id="setupPinLabel"
                    translation="[10, 18]"
                    width="680"
                    horizAlign="center"
                    vertAlign="center"
                    text="------"
                    font="font:LargeBoldSystemFont"
                    color="0xF57C00FF" />
            </Rectangle>

            <Label
                id="setupStatusLabel"
                translation="[480, 540]"
                width="1200"
                wrap="true"
                maxLines="2"
                text="Starting secure setup..."
                font="font:MediumSystemFont"
                color="0xAAAAAAFF" />

            <!-- Buttons -->
            <Rectangle id="btnNewPin" translation="[480, 640]" width="420" height="72" color="0x242832FF">
                <Label id="btnNewPinLabel" width="420" height="72" horizAlign="center" vertAlign="center" text="NEW CODE" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            </Rectangle>
            <Rectangle id="btnStreamTv" translation="[940, 640]" width="520" height="72" color="0xF57C00FF">
                <Label id="btnStreamTvLabel" width="520" height="72" horizAlign="center" vertAlign="center" text="STREAMINGTV LOGIN" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            </Rectangle>

            <Label
                translation="[480, 750]"
                width="1200"
                wrap="true"
                maxLines="2"
                text="This player does not include any media content. Use your own playlist or sign in with your StreamingTV account."
                font="font:SmallSystemFont"
                color="0x666666FF" />
        </Group>

        <!-- ================= STREAMINGTV LOGIN ================= -->
        <Group id="streamTvPanel" translation="[80, 180]" visible="false">
            <Label
                translation="[40, 20]"
                width="1700"
                text="StreamingTV Login"
                font="font:LargeBoldSystemFont"
                color="0xFFFFFFFF" />
            <Label
                translation="[40, 80]"
                width="1700"
                wrap="true"
                maxLines="2"
                text="Open your StreamingTV account page (or ask your Provider) and choose Link Device. Enter this code:"
                font="font:MediumSystemFont"
                color="0xAAAAAAFF" />

            <Rectangle translation="[200, 180]" width="900" height="140" color="0x1A1D24FF">
                <Label
                    id="linkCodeLabel"
                    translation="[10, 25]"
                    width="880"
                    horizAlign="center"
                    vertAlign="center"
                    text="------"
                    font="font:LargeBoldSystemFont"
                    color="0xF57C00FF" />
            </Rectangle>

            <Label
                id="linkStatusLabel"
                translation="[40, 360]"
                width="1700"
                wrap="true"
                maxLines="3"
                text="Waiting for activation..."
                font="font:MediumSystemFont"
                color="0xAAAAAAFF" />

            <Rectangle id="btnLinkNew" translation="[200, 480]" width="420" height="72" color="0x242832FF">
                <Label id="btnLinkNewLabel" width="420" height="72" horizAlign="center" vertAlign="center" text="NEW CODE" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            </Rectangle>
            <Rectangle id="btnLinkBack" translation="[680, 480]" width="420" height="72" color="0x242832FF">
                <Label id="btnLinkBackLabel" width="420" height="72" horizAlign="center" vertAlign="center" text="BACK" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            </Rectangle>
        </Group>

        <Timer id="pollTimer" repeat="true" duration="3" />
        <Timer id="expiryTimer" repeat="false" duration="600" />
    </children>
</component>
